{
  "name": "pi-extension-suite",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for the @momenttttt pi extension packages",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:docs": "node scripts/check-docs.mjs && node --test scripts/check-docs.test.mjs",
    "check": "npm run typecheck && npm run test && npm run check:docs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
