{
  "name": "@momenttttt/pi-zcode-memory",
  "version": "0.1.1",
  "description": "Share ZCode's per-project memory directory from pi (memory_read / memory_write / memory_list)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "memory",
    "zcode",
    "project-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Momenttttt/pi-extension-suite.git",
    "directory": "packages/pi-zcode-memory"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
