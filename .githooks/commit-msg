#!/bin/sh
# Conventional Commits 格式检查。
#
# 允许的类型是固定的几个；scope 可选。合并与回退提交放行（它们的主题行不是人写的）。
set -e

message_file="$1"
subject=$(head -n 1 "$message_file")

# 合并 / 默认合并信息 / 回退
case "$subject" in
  Merge\ *|Revert\ *|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|merge)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "提交信息不符合 Conventional Commits："
  echo "  $subject"
  echo "格式：<type>(<scope>)?: <描述>"
  echo "类型：feat fix docs style refactor perf test build ci chore revert merge"
  echo "示例：feat(read-guard): 未读就写已存在文件时阻断"
  exit 1
fi

# 主题行别太长（宽字符按两格算，这里只做粗略上限）
length=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$length" -gt 100 ]; then
  echo "提交主题行过长（$length 字符，上限 100）：$subject"
  exit 1
fi
